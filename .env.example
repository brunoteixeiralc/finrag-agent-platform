# Runtime environment: development, test, or production
FINRAG_ENVIRONMENT=development

# Local-only placeholders. Never reuse these values outside development.
FINRAG_API_KEY=replace-with-a-long-random-local-key
FINRAG_DB_USER=finrag
FINRAG_DB_PASSWORD=finrag-local-only
FINRAG_DB_NAME=finrag
FINRAG_DB_PORT=5432
FINRAG_DATABASE_URL=postgresql://finrag:finrag-local-only@localhost:5432/finrag
